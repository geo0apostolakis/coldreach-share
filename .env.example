# --- App access -------------------------------------------------------------
APP_PASSWORD=change-me
SESSION_SECRET=generate-with-openssl-rand-hex-32

# --- Google (sign in with your own account) ----------------------------------
# OAuth 2.0 Client ID, type "Web application", with these redirect URIs:
#   http://localhost:5600/callback   (for scripts/google-auth.mjs)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Produced once by: node scripts/google-auth.mjs
GOOGLE_REFRESH_TOKEN=
# API key from the same project, restricted to the Google Picker API.
GOOGLE_API_KEY=
# The project NUMBER (not the id). Required: without it the Picker cannot attach
# the drive.file grant to this client, and picked sheets stay unreadable.
GOOGLE_PROJECT_NUMBER=
# Created by: node scripts/init-control.mjs
CONTROL_SPREADSHEET_ID=

# --- Outlook / Microsoft Graph ----------------------------------------------
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Produced once by: node scripts/ms-auth.mjs
MS_REFRESH_TOKEN=

# --- AI ---------------------------------------------------------------------
OPENROUTER_API_KEY=

# --- Scheduler --------------------------------------------------------------
CRON_SECRET=generate-with-openssl-rand-hex-32

# --- Misc -------------------------------------------------------------------
# Where "Send test to me" delivers.
TEST_EMAIL_TO=you@example.com

# --- Lead Machine (optional) -------------------------------------------------
# Apify token, only needed if you use the Lead Machine to harvest leads.
APIFY_TOKEN=

# --- Pinger (optional, used by scripts/create-cron-job.mjs) ------------------
# cron-job.org API key, from cron-job.org > Settings > API.
CRONJOB_API_KEY=
